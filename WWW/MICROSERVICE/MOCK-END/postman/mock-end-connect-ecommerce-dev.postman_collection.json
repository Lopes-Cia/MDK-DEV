{
  "info": {
    "name": "MOCK-END - Connect Ecommerce (DEV)",
    "_postman_id": "b6f9f11d-3b0d-4b9f-9f2d-111111111111",
    "description": "Coleção DEV para testar rotas mock em /connect/Servidor/webservice/integration/* (auth, carrinho, pedidos e config).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000" },
    { "key": "connectPrefix", "value": "/connect" },
    { "key": "integrationPrefix", "value": "/Servidor/webservice/integration" },
    {
      "key": "authorizationToken",
      "value": "mock-integrator-token",
      "description": "No DEV, qualquer valor não vazio funciona (o proxy só valida a existência do header Authorization)."
    },
    { "key": "loginToken", "value": "123456", "description": "Preenchido automaticamente pelo request send-token." },
    { "key": "orderId", "value": "1", "description": "Preenchido automaticamente pelo checkout." }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "{{authorizationToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}{{connectPrefix}}{{integrationPrefix}}/auth/register"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"responsavel\": \"João da Silva\",\n  \"cnpj\": \"12345678000199\",\n  \"email\": \"joao.silva+dev@example.com\",\n  \"whatsapp\": \"62999998888\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Send Token (Email)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const r = pm.response.json();",
                  "const token = r?.data?.tokenPreview;",
                  "if (token) pm.collectionVariables.set('loginToken', String(token));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "{{authorizationToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}{{connectPrefix}}{{integrationPrefix}}/auth/send-token"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"joao.silva+dev@example.com\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Verify Token (Login) - seta cookie session",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "{{authorizationToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}{{connectPrefix}}{{integrationPrefix}}/auth/verify-token"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{loginToken}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Depois de executar, o Postman deve armazenar o cookie httpOnly `session` automaticamente (cookie jar)."
          }
        },
        {
          "name": "Me (sessão atual)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "{{authorizationToken}}" }],
            "url": { "raw": "{{baseUrl}}{{connectPrefix}}{{integrationPrefix}}/auth/me" }
          }
        },
        {
          "name": "Update Me (dados + endereços)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "{{authorizationToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}{{connectPrefix}}{{integrationPrefix}}/auth/me" },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"João da Silva Atualizado\",\n  \"telefone\": \"+5562999997777\",\n  \"enderecos\": [\n    {\n      \"id\": \"1\",\n      \"apelido\": \"Casa\",\n      \"destinatario\": \"João da Silva\",\n      \"telefone\": \"+5562999997777\",\n      \"cep\": \"74000000\",\n      \"uf\": \"GO\",\n      \"cidade\": \"Goiânia\",\n      \"bairro\": \"Centro\",\n      \"logradouro\": \"Rua 1\",\n      \"numero\": \"100\",\n      \"complemento\": \"\",\n      \"referencia\": \"\",\n      \"padrao\": true\n    }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "{{authorizationToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}{{connectPrefix}}{{integrationPrefix}}/auth/forgot-password" },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"joao.silva+dev@example.com\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "{{authorizationToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}{{connectPrefix}}{{integrationPrefix}}/auth/reset-password" },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"token-de-reset-dev\",\n  \"password\": \"NovaSenhaForte123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Para DEV, pegue um token real em passwordResets.json se quiser validar 100% o fluxo."
          }
        },
        {
          "name": "Privacy Delete (LGPD)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "{{authorizationToken}}" }],
            "url": { "raw": "{{baseUrl}}{{connectPrefix}}{{integrationPrefix}}/auth/privacy/delete" }
          }
        },
        {
          "name": "Logout (limpa cookie session)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "{{authorizationToken}}" }],
            "url": { "raw": "{{baseUrl}}{{connectPrefix}}{{integrationPrefix}}/auth/logout" }
          }
        }
      ]
    },
    {
      "name": "Cart",
      "item": [
        {
          "name": "Get Cart",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "{{authorizationToken}}" }],
            "url": { "raw": "{{baseUrl}}{{connectPrefix}}{{integrationPrefix}}/cart" }
          }
        },
        {
          "name": "Put Cart (substitui carrinho)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "{{authorizationToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}{{connectPrefix}}{{integrationPrefix}}/cart" },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"productId\": \"1001\",\n      \"sku\": \"HEINEKEN-LATA-269\",\n      \"name\": \"Heineken Lata 269ml\",\n      \"unitPrice\": 4.19,\n      \"qty\": 10\n    },\n    {\n      \"productId\": \"1002\",\n      \"sku\": \"HEINEKEN-LATA-350\",\n      \"name\": \"Heineken Lata 350ml\",\n      \"unitPrice\": 4.72,\n      \"qty\": 5\n    }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        }
      ]
    },
    {
      "name": "Orders",
      "item": [
        {
          "name": "Checkout (gera pedido e limpa carrinho)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const r = pm.response.json();",
                  "const id = r?.data?.orderId;",
                  "if (id != null) pm.collectionVariables.set('orderId', String(id));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "{{authorizationToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}{{connectPrefix}}{{integrationPrefix}}/orders/checkout" },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"address\": {\n    \"apelido\": \"Entrega Principal\",\n    \"destinatario\": \"João da Silva\",\n    \"telefone\": \"+5562999997777\",\n    \"cep\": \"74000000\",\n    \"uf\": \"GO\",\n    \"cidade\": \"Goiânia\",\n    \"bairro\": \"Centro\",\n    \"logradouro\": \"Rua 1\",\n    \"numero\": \"100\",\n    \"complemento\": \"Sala 101\",\n    \"referencia\": \"\"\n  },\n  \"payment\": {\n    \"meio\": \"pix\",\n    \"descricao\": \"PIX à vista\",\n    \"token\": \"chave-pix-mock-123\",\n    \"parcelas\": 1\n  }\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "List Orders",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "{{authorizationToken}}" }],
            "url": { "raw": "{{baseUrl}}{{connectPrefix}}{{integrationPrefix}}/orders" }
          }
        },
        {
          "name": "Order Detail",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "{{authorizationToken}}" }],
            "url": { "raw": "{{baseUrl}}{{connectPrefix}}{{integrationPrefix}}/orders/{{orderId}}" }
          }
        }
      ]
    },
    {
      "name": "Ecommerce",
      "item": [
        {
          "name": "Get Ecommerce Config",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "{{authorizationToken}}" }],
            "url": { "raw": "{{baseUrl}}{{connectPrefix}}{{integrationPrefix}}/ecommerce/config" }
          }
        }
      ]
    }
  ]
}

