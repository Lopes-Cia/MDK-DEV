{
  "info": {
    "name": "MOCK-END - Connect + Tenant",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000"
    },
    {
      "key": "AUTH_BASE_URL",
      "value": "http://localhost:4000"
    },
    {
      "key": "INTEGRATION_URL_API",
      "value": "http://localhost:4000"
    },
    {
      "key": "authorizationToken",
      "value": "mock-integrator-token"
    },
    {
      "key": "PRODUTO",
      "value": "CONNECT"
    },
    {
      "key": "EAN",
      "value": 7890000002998
    },
    {
      "key": "IDINTEGRADORA",
      "value": 8
    },
    {
      "key": "CODCLI",
      "value": 1219
    },
    {
      "key": "KEY",
      "value": "ODtDT05ORUNUOzEyMTk="
    },
    {
      "key": "COD_PROD",
      "value": 2001
    },
    {
      "key": "tenant",
      "value": "mercearia-lopes"
    },
    {
      "key": "TENANT_CATEGORY_SLUG",
      "value": "bebidas"
    },
    {
      "key": "TENANT_PRODUCT_SLUG",
      "value": "achocolatado-nescau-400g"
    },
    {
      "key": "TENANT_JSON_PATH",
      "value": "CONTEXTO/contexto.json"
    },
    {
      "key": "TENANT_JSON_DIR",
      "value": "CATALOGO"
    },
    {
      "key": "TENANT_ASSET_PATH",
      "value": "THEMA/assets/images/produtos/test.png"
    }
  ],
  "item": [
    {
      "name": "CONNECT",
      "item": [
        {
          "name": "Internos (/api)",
          "item": [
            {
              "name": "Auth - Register",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": "{{baseUrl}}/api/auth/register",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"responsavel\": \"Operador Mock\",\n  \"cnpj\": \"00.000.000/0000-00\",\n  \"email\": \"operador@mock.local\",\n  \"whatsapp\": \"5511999999999\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              }
            },
            {
              "name": "Auth - Send Token",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": "{{baseUrl}}/api/auth/send-token",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"operador@mock.local\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              }
            },
            {
              "name": "Auth - Verify Token",
              "description": "Use o tokenPreview retornado em Auth - Send Token para validar.",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": "{{baseUrl}}/api/auth/verify-token",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"token\": \"123456\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              }
            },
            {
              "name": "Auth - Me",
              "request": {
                "method": "GET",
                "header": [],
                "url": "{{baseUrl}}/api/auth/me"
              }
            },
            {
              "name": "Auth - Logout",
              "request": {
                "method": "POST",
                "header": [],
                "url": "{{baseUrl}}/api/auth/logout"
              }
            },
            {
              "name": "Products - List",
              "request": {
                "method": "GET",
                "header": [],
                "url": "{{baseUrl}}/api/products?idIntegradora={{IDINTEGRADORA}}"
              }
            },
            {
              "name": "Products - Detail",
              "request": {
                "method": "GET",
                "header": [],
                "url": "{{baseUrl}}/api/products/{{COD_PROD}}?idIntegradora={{IDINTEGRADORA}}"
              }
            }
          ]
        },
        {
          "name": "Externos - AUTH_BASE_URL",
          "item": [
            {
              "name": "tokenService - Generate",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": "{{AUTH_BASE_URL}}/tokenService",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"produto\": \"{{PRODUTO}}\",\n  \"ean\": \"{{EAN}}\",\n  \"idIntegradora\": \"{{IDINTEGRADORA}}\",\n  \"codCli\": \"{{CODCLI}}\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              }
            },
            {
              "name": "tokenService - Refresh",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": "{{AUTH_BASE_URL}}/tokenService",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"refreshToken\": \"mock-refresh-token\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              }
            },
            {
              "name": "postAutenteicaAplicativo",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
                    "key": "Authorization",
                    "value": "{{authorizationToken}}"
                  }
                ],
                "url": "{{AUTH_BASE_URL}}/postAutenteicaAplicativo",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"chaveAtivacao\": \"{{KEY}}\",\n  \"responsavel\": \"Operador Mock\",\n  \"cnpj\": \"00.000.000/0000-00\",\n  \"email\": \"operador@mock.local\",\n  \"whatsapp\": \"5511999999999\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              }
            },
            {
              "name": "enviarToken",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "{{authorizationToken}}"
                  }
                ],
                "url": "{{AUTH_BASE_URL}}/enviarToken?email=operador%40mock.local"
              }
            },
            {
              "name": "verificarTokenSistema",
              "description": "Use o tokenPreview retornado em enviarToken (ou no fluxo interno) para validar.",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "{{authorizationToken}}"
                  }
                ],
                "url": "{{AUTH_BASE_URL}}/verificarTokenSistema?token=123456"
              }
            },
            {
              "name": "getOperadorSistemaForId",
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "{{authorizationToken}}"
                  }
                ],
                "url": "{{AUTH_BASE_URL}}/getOperadorSistemaForId?id=1"
              }
            }
          ]
        },
        {
          "name": "Externos - INTEGRATION_URL_API",
          "item": [
            {
              "name": "getIntegradora",
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "{{authorizationToken}}"
                  }
                ],
                "url": "{{INTEGRATION_URL_API}}/Servidor/webservice/integration/getIntegradora?id={{IDINTEGRADORA}}"
              }
            },
            {
              "name": "getListProdutoLoja",
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "{{authorizationToken}}"
                  }
                ],
                "url": "{{INTEGRATION_URL_API}}/Servidor/webservice/integration/getListProdutoLoja?idIntegradora={{IDINTEGRADORA}}"
              }
            },
            {
              "name": "getProdutoLoja",
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "{{authorizationToken}}"
                  }
                ],
                "url": "{{INTEGRATION_URL_API}}/Servidor/webservice/integration/getProdutoLoja?idIntegradora={{IDINTEGRADORA}}&codProd={{COD_PROD}}"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "TENANT",
      "item": [
        {
          "name": "Categorias (list)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/tenant/{{tenant}}/catalogo/categorias"
          }
        },
        {
          "name": "Categorias (detail)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/tenant/{{tenant}}/catalogo/categorias/{{TENANT_CATEGORY_SLUG}}"
          }
        },
        {
          "name": "Produtos (list)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/tenant/{{tenant}}/catalogo/produtos"
          }
        },
        {
          "name": "Produtos (detail)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/tenant/{{tenant}}/catalogo/produtos/{{TENANT_PRODUCT_SLUG}}"
          }
        },
        {
          "name": "JSON (get)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/tenant/{{tenant}}/json?path={{TENANT_JSON_PATH}}"
          }
        },
        {
          "name": "JSON (list)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/tenant/{{tenant}}/json/list?dir={{TENANT_JSON_DIR}}"
          }
        },
        {
          "name": "JSON (put)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/tenant/{{tenant}}/json?path={{TENANT_JSON_PATH}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tenantId\": \"{{tenant}}\",\n  \"updatedAt\": \"2026-01-01T00:00:00.000Z\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "JSON (delete)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/tenant/{{tenant}}/json?path={{TENANT_JSON_PATH}}"
          }
        },
        {
          "name": "Assets (put)",
          "description": "Envie o body como binary (ex.: PNG) para salvar em THEMA/assets/images/.",
          "request": {
            "method": "PUT",
            "header": [],
            "url": "{{baseUrl}}/api/tenant/{{tenant}}/assets?path={{TENANT_ASSET_PATH}}"
          }
        },
        {
          "name": "Assets (delete)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/tenant/{{tenant}}/assets?path={{TENANT_ASSET_PATH}}"
          }
        }
      ]
    }
  ]
}
