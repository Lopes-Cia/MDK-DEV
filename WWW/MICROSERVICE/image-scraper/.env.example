TARGET_TYPE=produto
INPUT_JSON=./data/input/produtos.json
OUTPUT_JSON=./data/output/produtos.json
META_JSON=./data/output/image-meta.json
NOT_FOUND_JSON=./data/output/not-found.json
ASSETS_DIR=./data/assets/images
ASSETS_BASE_URL=/assets/images
SSE_HUB_URL=http://localhost:4001
MODE=safe
MAX_CONCURRENCY=5
MIN_IMAGE_BYTES=10000
MIN_IMAGE_ASPECT_RATIO=0.35
MAX_IMAGE_ASPECT_RATIO=1.35
REQUIRE_WHITE_BG_HINT=1
USE_VISUAL_FILTER=1
VISUAL_MIN_WHITE_RATIO=0.60
VISUAL_WHITE_THRESHOLD=238
VISUAL_MIN_OBJECT_COVERAGE=0.03
VISUAL_MAX_OBJECT_COVERAGE=0.58
VISUAL_MAX_COMPONENTS=2
ENABLE_RELAXED_RETRY_PROFILE=1
RELAXED_REQUIRE_WHITE_BG_HINT=0
RELAXED_MIN_IMAGE_ASPECT_RATIO=0.30
RELAXED_MAX_IMAGE_ASPECT_RATIO=1.60
RELAXED_USE_VISUAL_FILTER=1
RELAXED_VISUAL_MIN_WHITE_RATIO=0.50
RELAXED_VISUAL_WHITE_THRESHOLD=232
RELAXED_VISUAL_MIN_OBJECT_COVERAGE=0.02
RELAXED_VISUAL_MAX_OBJECT_COVERAGE=0.68
RELAXED_VISUAL_MAX_COMPONENTS=3
CANDIDATE_POOL_SIZE=120
CANDIDATE_EVAL_LIMIT=40
PLACEHOLDER_ON_NOT_FOUND=1
PLACEHOLDER_IMAGE_URL=/assets/images/semImagem.png
